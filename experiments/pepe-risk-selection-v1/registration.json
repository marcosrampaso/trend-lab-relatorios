{"id":"pepe-risk-selection-v1","registeredAt":1792500639778,"protocol":{"id":"pepe-risk-selection-v1","symbol":"1000PEPEUSDT","purpose":"Offline retrospective diagnostic of feature selection, risk classification, sigmoid calibration and subsequent evaluation. No PPO integration or orders.","features":["RSI5m","ATR5m/price","logRVOL5m","VWAP distance/ATR","EMA9/21 distance/ATR","MACD histogram/ATR","taker delta","trend1h","trend4h","EMA20/50 distance/ATR1h","EMA20/50 distance/ATR4h","return5m","volumeAvailable5m","vwapAvailable5m","rvolAvailable5m","candidateSide"],"protectedIndices":[12,13,14,15],"classes":["baixo","moderado","alto"],"samplingMinutes":30,"horizonMinutes":30,"stopATR":1.5,"entrySlippage":0.001,"excludedMonths":["2024-08"],"folds":[{"id":"f1","fit":["2023-06","2024-03"],"calibration":["2024-03","2024-05"],"evaluation":["2024-05","2024-08"],"inner":[["2023-09","2023-11"],["2023-11","2024-01"],["2024-01","2024-03"]]},{"id":"f2","fit":["2023-06","2024-09"],"calibration":["2024-09","2024-10"],"evaluation":["2024-10","2025-01"],"inner":[["2024-03","2024-05"],["2024-05","2024-07"],["2024-07","2024-09"]]},{"id":"f3","fit":["2023-06","2025-01"],"calibration":["2025-01","2025-04"],"evaluation":["2025-04","2025-07"],"inner":[["2024-07","2024-09"],["2024-09","2024-11"],["2024-11","2025-01"]]}],"seeds":[19,73,151],"families":["nb","logistic"],"selectionModes":["all","selected"],"calibrationModes":["raw","sigmoid"],"selection":{"method":"StandardScaler + SelectFromModel(LogisticRegression L1, solver saga), threshold mean; union with protectedIndices","CGrid":[0.001,0.01,0.1],"criterion":"Minimum mean inner chronological log loss of the complete pipeline and its classifier; ties choose first C. Neither outer calibration nor evaluation tunes C.","maxIter":1500,"tol":0.001},"classifiers":{"nb":{"varSmoothing":1e-06},"logistic":{"C":1.0,"maxIter":1000}},"calibration":"Freeze the fitted training pipeline with FrozenEstimator, then fit CalibratedClassifierCV(method=sigmoid) on the separate, later calibration block. No base refit on calibration.","innerGapMinutes":30,"metrics":["multiclass Brier (unscaled sum across three classes)","log loss","high-risk Brier","balanced accuracy","class recall","confusion matrix","high-risk reliability bins with counts","monthly probability scores"],"baselines":["training class frequencies with Laplace smoothing","training ATR/price tercile class frequencies with Laplace smoothing"],"bootstrap":{"repetitions":500,"seed":20261020,"unit":"UTC calendar day","confidence":0.95,"note":"Paired differences in Brier, averaged over seeds for each case before daily block resampling. Keeps both candidate directions in the same block. Conditional descriptive uncertainty; no training or asset-selection uncertainty captured."},"label":"Maximum adverse price excursion in the next30m from the next1m opening reference with adverse entry slippage. Low <0.5 initial stop distance; moderate 0.5..<1; high >=1. This is a future-path label, not an input, probability of profit, or a net trading return; fees/funding are not part of this label.","dataRules":["Features must be known at decision time.","Every future label fully matures within its split and month; candidate directions at the same timestamp never cross a split.","Inner fitting labels mature at least30min before inner validation starts.","Both directions are scored only when the first execution minute has volume; skipped windows are counted.","August2024 is excluded consistently because the installed financial research omitted its incomplete mark-price data."],"interpretation":["All periods have already been available to prior research. Temporal separation within this experiment does not make them an untouched independent final test.","No 2025-07+ packets opened. The V3 prospective final test remains locked.","Three seeds check selector optimization stability, not three independent market histories.","A lower Brier or log loss does not by itself demonstrate better calibration at every probability level or profitable trading.","Protected availability flags and candidate direction remain even if rare/constant. No portfolio features are removed from the separate PPO.","No winner is promoted automatically. Financial utility requires a separately registered continuous-wallet comparison with costs and CDI."],"threads":1,"realOrders":false,"ppoConnected":false,"automaticPromotion":false,"primaryEvaluationMetric":"Log loss, weighted equally per evaluated candidate across the three nonoverlapping windows; Brier and reliability reported separately."},"sourceHashes":{"pepe-risk-selection-protocol.json":"a6d6606d0b73c0d424f76de1fc50cbb250236f1a12811249bc36f24c98c7f830","scripts/run-pepe-risk-selection.py":"ce2fa18e2b75bbd2210621847877179f328f8e8c411350a5b17b408c7ed1f25f","scripts/pepe_risk_selection.py":"6995bf1e1f05a74211d9850ad8c94d8f5c842fcaf572a2ea36923b4352e4bfc4","scripts/pepe-nb-risk-core.py":"89960c2212936ca943ca0636ea9418cbc37a65a6935bc0a159d74d93e20259d0","data/pepe-finrl-v1/features/index.json":"5b774d649972da9943999a898e84bc78d441a0f24a6b772a2ff54454095725f9"},"dataHashes":{"data/pepe-finrl-v1/features/2023-06.json":"e038e1d725fb4578f04a87f43981a6cf2b8d9a338d7049f836a2311194b9f530","data/pepe-finrl-v1/2023-06.json":"1b55d20ba8c811501be18d909f2baea41d7ae647bde218794cae98d9d0bb6def","data/pepe-finrl-v1/features/2023-07.json":"4e58903ac1f1b9be79e8cc09fa38ab56d18ac74ec6ca613f6be1a4a8d7bb3996","data/pepe-finrl-v1/2023-07.json":"b72422e4300dc01712f23001feee60412a62af66af3013c2b40e1ed7acfbbd7f","data/pepe-finrl-v1/features/2023-08.json":"dbe47316f9df646d4b86a2ecb510115e9d1bd491f9375ec82d300c6460934eb7","data/pepe-finrl-v1/2023-08.json":"c1cc5427c728c97c04a8e93fbfa207a85571bfe8a0fa4fff10301c98104fc8bb","data/pepe-finrl-v1/features/2023-09.json":"d3ac3f55fbad3f0c41cbb1cb421ac566adf8c843fc2f8db1d91f4551579fcb04","data/pepe-finrl-v1/2023-09.json":"0015e0402fa72dab40ea636d880342b7f3a9349d723146215b294e7515fce72c","data/pepe-finrl-v1/fea