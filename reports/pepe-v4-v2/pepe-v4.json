s used in V3 fitness or called an independent test. Final V3 results stay pending until a new prospective calendar is separately registered and frozen.", "Risk 1%, daily loss 3%, total loss 10%, leverage choice 10x/15x and stressed execution costs unchanged. No forced trading, live orders, paid AI API, credentials or network calls during training.", "One thousand target generations, 250 logical agents, three worker processes in boost / one in eco, two Torch threads per worker. 48-hour active compute budget; checkpoint and pause rather than promise overnight completion."], "reserved": "2026-09", "excludedTraining": [{"start": "2024-08", "end": "2024-09", "reason": "Two actual mark-price minutes absent from monthly, daily and REST archives. Whole month excluded from reward/trading episodes; its valid price candles can still supply causal indicator context."}], "allowedLeverages": [10, 15], "requireVolume": true, "development": {"start": "2024-10", "end": "2025-01"}, "population": 25, "generations": 20, "workers": 3, "ecoWorkers": 1, "stepsPerGeneration": 1024, "probeDays": 2, "minimumMaturity": 5, "eliteFraction": 0.1, "replaceFraction": 0.2, "immigrantFraction": 0.05, "anchorEveryGenerations": 50, "finalists": 10, "maxWallHours": 48, "minimumFreeGiB": 10, "hyperparameters": {"learning_rate": [0.0001, 0.0002, 0.0003, 0.0005, 0.001], "ent_coef": [0.001, 0.003, 0.01, 0.02, 0.03], "gamma": [0.95, 0.97, 0.99, 0.995], "clip_range": [0.1, 0.2, 0.3]}, "globalSeed": 20261020, "threadsPerWorker": 2, "observationCount": 38, "createdAt": 1792590013857, "founder": {"label": "V3 G91 / agente 245", "generation": 91, "agent": 245, "modelPath": "work/pepe-v4-v2/founder.zip", "modelSHA256": "2ee954256829b8ffea36a4fea682ac3c15f046e8ca76e34c3cc4d9f9fd42dc0b", "hyperparameters": {"learning_rate": 0.0003, "ent_coef": 0.01, "gamma": 0.995, "clip_range": 0.3}, "selectionUsesV3Final": false}, "seed": 2026102104, "maximumWorkers": 5, "cost": "stress", "learningRates": [1e-06, 1e-05, 3e-05, 0.